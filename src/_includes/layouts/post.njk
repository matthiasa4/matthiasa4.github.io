---
layout: layouts/base.njk
---

{% block head %}
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}">
{% if featuredImage %}
<meta name="image" property="og:image" content="{{ site.url }}{{ featuredImage }}">
{% endif %}
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
{% endblock %}

{% set processedContent = content | safe %}
{% set tocContent = processedContent | extractToc %}
{% set mainContent = processedContent | removeToc %}

<div class="post-layout">
    <!-- TOC on right (desktop) / top (mobile) -->
    {% if tocContent %}
    <aside class="toc-wrapper">
        <nav class="toc-nav">
            <h2 class="toc-title">Table of Contents</h2>
            {{ tocContent | safe }}
        </nav>
    </aside>
    {% endif %}
    
    <!-- Main content -->
    <article class="post-container">
        <div class="post-header">
            <h1>{{ title }}</h1>
            <time datetime="{{ page.date | dateIso }}">{{ page.date | dateReadable }}</time>
        </div>
        
        <div class="post-content">
            {{ mainContent | safe }}
        </div>
    </article>
</div>